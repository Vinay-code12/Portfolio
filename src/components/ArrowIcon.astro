---
// Small inline icons used in buttons and links.
interface Props {
  variant?: 'outward' | 'download';
  size?: number;
  strokeWidth?: number;
}

const { variant = 'outward', size = 14, strokeWidth = 2.4 } = Astro.props;
const path = variant === 'download' ? 'M12 4v11M7 10l5 5 5-5M5 20h14' : 'M7 17 17 7M8 7h9v9';
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d={path} />
</svg>
